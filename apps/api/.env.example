# Copiar a .env (al costat del docker-compose.yml). MAI pujar el .env al repo.
POSTGRES_PASSWORD=canvia-aixo
# Correus que entren sempre i amb rol tutor (separats per comes)
PASAPAS_TUTOR_EMAILS=biel@example.com
# URL pública del portal (destí dels enllaços de rescat del CLI)
PASAPAS_PORTAL_URL=https://pasapas.nereidlabs.net
# 1 en producció (cookie només per https)
PASAPAS_COOKIE_SECURE=1
# console (el codi surt al log: `docker compose logs api`) | smtp | memoria (tests)
# Alternativa sense correu: el tutor genera el codi des del panell d'administració.
PASAPAS_MAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=pasapas@nereidlabs.net
