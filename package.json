{
  "name": "pasapas",
  "private": true,
  "description": "Pas a pas · Àlgebra — pràctica d'àlgebra bàsica amb errors catalogats",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "npm run dev -w @pasapas/web",
    "build": "npm run build -w @pasapas/web",
    "start": "npm run start -w @pasapas/web",
    "test": "npm run test --workspaces --if-present",
    "test:seeds": "PASAPAS_SEEDS=2000 npm run test -w @pasapas/content-algebra",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
